# ---- Build stage: install Python dependencies ----
FROM python:3.12-slim AS builder

WORKDIR /app

# Copy dependency manifest and install into a virtual env
# Uses tomllib (stdlib in 3.12) to parse dependencies from pyproject.toml
COPY backend/pyproject.toml .

RUN pip install --no-cache-dir --upgrade pip uv && \
    mkdir -p /opt/venv && \
    python -c "import tomllib; deps=tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; print('\n'.join(deps))" > /tmp/requirements.txt && \
    uv venv /opt/venv && \
    uv pip install --no-cache -r /tmp/requirements.txt

# ---- Runtime stage ----
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Copy virtual env from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY backend/ /app/

# Create non-root user
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# Data directory for SQLite database (mount as volume in production)
RUN mkdir -p /app/data
VOLUME ["/app/data"]

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:9000/api/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "9000"]
