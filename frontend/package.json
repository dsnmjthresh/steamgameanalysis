    "pinia": "3.0.4",
    "shiki": "4.0.2",
    "tailwindcss": "4.2.4",
    "vue": "3.5.33",
    "vue-echarts": "8.0.1",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "25.6.0",
    "@vue/test-utils": "2.4.10",
    "eslint": "^9.39.4",
