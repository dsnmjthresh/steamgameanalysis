STEAMANALYSIS_ENV=development
STEAMANALYSIS_DATABASE_URL=sqlite:///./steamanalysis.sqlite3
STEAMANALYSIS_DEFAULT_CC=CN
STEAMANALYSIS_DEFAULT_LANGUAGE=schinese
STEAMANALYSIS_DEFAULT_CURRENCY=CNY
STEAMANALYSIS_DEEPSEEK_MODEL=deepseek-v4-pro
STEAMANALYSIS_ALLOW_MODEL_FALLBACK=true
STEAMANALYSIS_FIRECRAWL_API_URL=https://api.firecrawl.dev
STEAMANALYSIS_WEB_SEARCH_BACKEND=auto
# Set this for any non-local deployment. When empty, write/private API routes are rejected.
STEAMANALYSIS_AUTH_TOKEN=

# ---- LLM provider ----
# STEAMANALYSIS_LLM_PROVIDER=deepseek
# STEAMANALYSIS_LLM_MODEL=gpt-4o-mini
# STEAMANALYSIS_LLM_API_BASE=

# ---- Embedding provider ----
# Valid values: "hash" (default, zero-cost, no semantics) | "openai" (semantic, needs OPENAI_API_KEY)
# DeepSeek does NOT support embeddings — setting "deepseek" will auto-fallback to hash.
# STEAMANALYSIS_EMBEDDING_PROVIDER=hash
# STEAMANALYSIS_EMBEDDING_MODEL=text-embedding-3-small
# STEAMANALYSIS_EMBEDDING_DIM=1536
# STEAMANALYSIS_EMBEDDING_API_BASE=
# STEAMANALYSIS_EMBEDDING_HASH_DIM=256

# Keep secrets in your local .env only.
DEEPSEEK_API_KEY=
STEAM_API_KEY=
FIRECRAWL_API_KEY=
